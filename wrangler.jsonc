{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lazar-sh",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "lazar.sh", "custom_domain": true },
    { "pattern": "www.lazar.sh", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist"
  }
}
